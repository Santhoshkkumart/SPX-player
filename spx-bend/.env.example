# Server Environment (production or development)
NODE_ENV=production

# Server Port (default: 3000)
PORT=3000

# SQLite Database Path (default: ./data/player.db)
DATABASE_PATH=./data/player.db

# JWT Security Secrets (Must be at least 32 characters long in production)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long

# Token Expiration Settings
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MEDIA_TOKEN_TTL=15m

# CORS Origin Settings (leave empty or set to * to allow mobile app connections from any IP)
CORS_ORIGIN=*

# Optional Cloudinary Storage (leave blank to store audio files locally in music/ directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AUDIO_FOLDER=spx-player

# Optional Admin Pre-creation
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=