                />
              )}
              ListEmptyComponent={<Text style={styles.emptyPlaylistText}>No songs in this playlist.</Text>}
              contentContainerStyle={{ padding: 24 }}
            />
          </SafeAreaView>
        </View>
      )}
    </SafeAreaView>
    </SafeAreaProvider>
  );
}

